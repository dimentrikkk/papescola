# Copie para .env e ajuste. No PC:   set -a; . ./.env; set +a
# No Raspberry Pi o systemd lê este ficheiro (EnvironmentFile).

ESCOLA_NOME="Escola Profissional Profitecla"
ESCOLA_CONTACTO="secretaria@profitecla.pt · 2xx xxx xxx"   # aparece no fim dos emails aos encarregados

# --- Segurança ---
# SESSION_SECRET=         # opcional: se faltar, gera-se um segredo aleatório em data/.secret_key
ADMIN_EMAIL=admin@escola.pt
# ADMIN_PASSWORD=         # opcional: se faltar, é gerada e mostrada UMA vez no arranque
COOKIE_SECURE=false       # true quando o site estiver atrás de HTTPS
KIOSK_WEB_ENABLED=true    # false em produção: o Pi usa o porteiro, não o browser

# --- Regras de assiduidade (contam só a 1.ª entrada e a última saída do dia) ---
TOLERANCIA_ATRASO_MIN=5       # entrar até 5 min depois da hora = presente
FALTA_APOS_MIN=30             # sem entrada 30 min depois da hora → falta (e email ao EE)
SAIDA_ANTECIPADA_TOL_MIN=5
AVISAR_EE_ATRASO=true         # email ao encarregado de educação (EE)
AVISAR_EE_FALTA=true
AVISAR_SAIDA_ANTECIPADA=false
COOLDOWN_SEGUNDOS=30

# --- Privacidade ---
GUARDAR_FOTOS_ACESSO=false
RETENCAO_EVENTOS_DIAS=90

# --- Reconhecimento ---
FACE_TOLERANCE=0.5        # mais baixo = mais estrito
FACE_SCALE=0.5            # 0.5 = metade da resolução (mais rápido no Pi)

# --- Hardware ---
HARDWARE_MODO=mock        # real no Raspberry Pi
CAMARA_INDEX=0
DISPLAY_TIPO=lcd          # lcd | oled | none
DISPLAY_I2C_ADDR=0x27     # confirme com: i2cdetect -y 1  (OLED costuma ser 0x3C)
DISPLAY_COLS=16
DISPLAY_ROWS=2
PIN_LED_VERDE=17
PIN_LED_VERMELHO=27
PIN_BUZZER=22
PIN_RELE=23
PIN_CHAVE=24
RELE_ACTIVE_HIGH=false    # a maioria dos módulos relé liga com 0 V
TRINCO_MODO=energiza_para_abrir   # ou energiza_para_trancar (trinco fail-safe)
TRINCO_SEGUNDOS=4

# --- Email aos encarregados (EE). Sem SMTP os avisos ficam na fila, visível no painel ---
# SMTP_HOST=smtp.exemplo.pt
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@escola.pt
