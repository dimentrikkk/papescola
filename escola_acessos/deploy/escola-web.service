# sudo cp deploy/escola-web.service /etc/systemd/system/ && sudo systemctl enable --now escola-web
[Unit]
Description=Escola Segura - site (gunicorn)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/escola_acessos
EnvironmentFile=/home/pi/escola_acessos/.env
ExecStart=/home/pi/escola_acessos/.venv/bin/gunicorn -w 2 -b 0.0.0.0:8000 main:app
Restart=always

[Install]
WantedBy=multi-user.target
